<Project Sdk="Microsoft.NET.Sdk">
  <!-- Facepunch.Steamworks.Win64.dll and steam_api64.dll come from the MPN-Workshop-Uploader release zip
       (github.com/placenamehereig/MPN-Workshop-Uploader, MIT); unzip them into lib/. Nothing is committed. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="Facepunch.Steamworks.Win64"><HintPath>lib/Facepunch.Steamworks.Win64.dll</HintPath></Reference>
    <None Include="lib/steam_api64.dll" Link="steam_api64.dll" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
